digraph G {
    newrank=true;
    compound=true;
    rankdir=TB;
    splines=true;
    nodesep=0.5;
    ranksep=0.4;

    node [shape=record, height=.1];

    { 
        rank=same; 
        node [shape=point, style=invis, width=0];
        anchor0 -> anchor1 -> anchor2 [style=invis]; 
    }

    subgraph cluster_col0 {
        label = "Блок 1"; color=lightgray; style=dashed;
        { rank=same; anchor0; node0; }

        node0 [label="{ Index: 0 | { <p> prev: 4 | data: 69 | <n> next: 1 } }", style=filled, fillcolor=lightblue, gradientangle=90];
        node1 [label="{ TAIL\nIndex: 1 | { <p> prev: 0 | data: 100 | <n> next: 2 } }"];
        node2 [label="{ Index: 2 | { <p> prev: 1 | data: 200 | <n> next: 3 } }"];
        node3 [label="{ Index: 3 | { <p> prev: 2 | data: 300 | <n> next: 4 } }"];
    }

    subgraph cluster_col1 {
        label = "Блок 2"; color=lightgray; style=dashed;
        { rank=same; anchor1; node4; }

        node4 [label="{ HEAD\nIndex: 4 | { <p> prev: 3 | data: 400 | <n> next: 0 } }"];
        node5 [label="{ Index: 5 | { <p> prev: -1 | data: 0 | <n> next: -1 } }"];
        node6 [label="{ Index: 6 | { <p> prev: -1 | data: 0 | <n> next: -1 } }"];
        node7 [label="{ Index: 7 | { <p> prev: -1 | data: 0 | <n> next: -1 } }"];
    }

    subgraph cluster_col2 {
        label = "Блок 3"; color=lightgray; style=dashed;
        { rank=same; anchor2; node8; }

        node8 [label="{ Index: 8 | { <p> prev: -1 | data: 0 | <n> next: -1 } }"];
        node9 [label="{ Index: 9 | { <p> prev: -1 | data: 0 | <n> next: -1 } }"];
    }

    node0:n -> node1:p [color=blue];
    node0:p -> node4:n [color=red, style=dashed];
    node1:n -> node2:p [color=blue];
    node1:p -> node0:n [color=red, style=dashed];
    node2:n -> node3:p [color=blue];
    node2:p -> node1:n [color=red, style=dashed];
    node3:n -> node4:p [color=blue];
    node3:p -> node2:n [color=red, style=dashed];
    node4:n -> node0:p [color=blue];
    node4:p -> node3:n [color=red, style=dashed];
}
