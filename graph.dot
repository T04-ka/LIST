digraph G {
    newrank = true;

    rankdir=TB;
    splines=true;

    node [shape=record, height=.1, width=1.2];

    // --- 1. ФИКСАЦИЯ СТОЛБЦОВ ПО ГОРИЗОНТАЛИ С ПОМОЩЬЮ НЕВИДИМЫХ ЯКОРЕЙ ---
    // Создаем 5 невидимых точек-ориентиров и жестко выстраиваем их слева направо
    {
        rank=same;
        node [shape=point, style=invis, width=0];
        anchor1 -> anchor2 -> anchor3 -> anchor4 -> anchor5 [style=invis];
    }

    // --- 2. ОПРЕДЕЛЕНИЕ УЗЛОВ ПО СТОЛБЦАМ ---

    // Столбец 1
    subgraph cluster_col1 {
        label = "Столбец 1"; color=lightgray; style=dashed;
        // Привязываем верхушку столбца к первому горизонтальному якорю
        { rank=same; anchor1; tail; }

        tail [label="{ <prev> • | TAIL | <next> • }"];
        a1   [label="{ <prev> • | data: A1 | <next> • }"];
        a2   [label="{ <prev> • | data: A2 | <next> • }"];
    }

    // Столбец 2
    subgraph cluster_col2 {
        label = "Столбец 2"; color=lightgray; style=dashed;
        { rank=same; anchor2; b1; }

        b1   [label="{ <prev> • | data: B1 | <next> • }"];
        b2   [label="{ <prev> • | data: B2 | <next> • }"];
        b3   [label="{ <prev> • | data: B3 | <next> • }"];
    }

    // Столбец 3
    subgraph cluster_col3 {
        label = "Столбец 3"; color=lightgray; style=dashed;
        { rank=same; anchor3; c1; }

        c1   [label="{ <prev> • | data: C1 | <next> • }"];
        c2   [label="{ <prev> • | data: C2 | <next> • }"];
    }

    // Столбец 4
    subgraph cluster_col4 {
        label = "Столбец 4"; color=lightgray; style=dashed;
        { rank=same; anchor4; d1; }

        d1   [label="{ <prev> • | data: d1 | <next> • }"];
        d2   [label="{ <prev> • | data: d2 | <next> • }"];
        d3   [label="{ <prev> • | data: d3 | <next> • }"];
    }

    // Столбец 5
    subgraph cluster_col5 {
        label = "Столбец 5"; color=lightgray; style=dashed;
        { rank=same; anchor5; e1; }

        e1   [label="{ <prev> • | data: E1 | <next> • }"];
        e2   [label="{ <prev> • | data: E2 | <next> • }"];
        head [label="{ <prev> • | HEAD | <next> • }"];
    }

    // --- 3. СВЯЗИ ВНУТРИ СТОЛБЦОВ И МЕЖДУ НИМИ ---

    // Цепочка Столбца 1
    tail:next -> a1:prev;
    a1:next -> a2:prev;

    // Переход со Столбца 1 на Столбец 2
    a2:next -> b1:prev;

    // Цепочка Столбца 2
    b1:next -> b2:prev;
    b2:next -> b3:prev;

    // Переход со Столбца 2 на Столбец 3
    b3:next -> c1:prev;

    // Цепочка Столбца 3
    c1:next -> c2:prev;

    // Переход со Столбца 3 на Столбец 4
    c2:next -> d1:prev;

    // Цепочка Столбца 4
    d1:next -> d2:prev;
    d2:next -> d3:prev;

    // Переход со Столбца 4 на Столбец 5
    d3:next -> e1:prev;

    // Цепочка Столбца 5 и выход на HEAD
    e1:next -> e2:prev;
    e2:next -> head:prev;
}
